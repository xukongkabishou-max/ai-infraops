# Shared examples only. Put real secrets in local .env files.

# Admin web
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_RBAC_API_BASE_URL=http://localhost:8000

# Future services
AUTH_SERVICE_URL=http://localhost:8100
PYTHON_OPS_API_URL=http://localhost:8200
K8S_SERVICE_URL=http://localhost:8300
BACKEND_RBAC_API_URL=http://localhost:8000

# MySQL for RBAC backend
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=infraops
MYSQL_USER=root
MYSQL_PWD=change-me
_MYSQL_PWD=change-me

# Redis for auth sessions
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0
REDIS_TLS=false
SESSION_TTL_SECONDS=86400

# Kubernetes credentials are encrypted before being stored in MySQL.
K8S_CONNECT_TIMEOUT_SECONDS=5
K8S_READ_TIMEOUT_SECONDS=20
K8S_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Middleware passwords use a separate key. During migration only, the backend can
# derive a domain-separated key from K8S_CREDENTIAL_ENCRYPTION_KEY when this is empty.
MIDDLEWARE_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Nacos catalog queries return metadata only, never configuration content.
NACOS_CONNECT_TIMEOUT_SECONDS=5
NACOS_READ_TIMEOUT_SECONDS=15

# Backend structured logs. Relative paths are resolved from the repository root.
LOG_LEVEL=INFO
LOG_DIR=.local/logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
