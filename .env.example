# Shared examples only. Put real secrets in local .env files.

# Admin web
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_RBAC_API_BASE_URL=http://localhost:8000

# Future services
AUTH_SERVICE_URL=http://localhost:8100
PYTHON_OPS_API_URL=http://localhost:8200
K8S_SERVICE_URL=http://localhost:8300
BACKEND_RBAC_API_URL=http://localhost:8000

# MySQL for RBAC backend
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=infraops
MYSQL_USER=root
MYSQL_PWD=change-me
_MYSQL_PWD=change-me

# Redis for auth sessions
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0
REDIS_TLS=false
SESSION_TTL_SECONDS=86400

# Kubernetes credentials are encrypted before being stored in MySQL.
K8S_CONNECT_TIMEOUT_SECONDS=5
K8S_READ_TIMEOUT_SECONDS=20
K8S_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
